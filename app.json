{
  "expo": {
    "name": "VentanaGo",
    "slug": "rn-ventanago",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ventanago",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "cl.ventanago.app"
    },
    "android": {
      "package": "cl.ventanago.app",
      "adaptiveIcon": {
        "backgroundColor": "#2b4c7e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2b4c7e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "@reactvision/react-viro",
        {
          "provider": "none",
          "android": {
            "xRMode": [
              "AR"
            ]
          }
        }
      ],
      "./plugins/registroDeFallos"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://ventanago-api.onrender.com",
      "imagenBaseUrl": "https://ventanago.vercel.app/",
      "eas": {
        "projectId": "e5f6b857-d40e-4037-9dbd-6dd3d29ab54f"
      }
    },
    "owner": "erickrcts-team"
  }
}
